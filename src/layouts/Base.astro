---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
// same hashed file the @fontsource CSS points to (Vite dedupes it): preloading it removes the font-swap layout shift
import manrope from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  /** Home only: the header starts transparent over the hero. */
  overlay?: boolean;
  /** The page's first surface runs under the header and reserves its height itself. */
  flush?: boolean;
}
const {
  title,
  description = 'Tecnología ortopédica y conocimiento especializado al servicio de cada procedimiento.',
  overlay = false,
  flush = false,
} = Astro.props;
const og = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f7" />
    <meta name="robots" content="noindex" /><!-- pre-launch (D-008): remove when the official domain goes live -->
    <link rel="preload" href={manrope} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="FIARIL Orthopedics" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FIARIL Orthopedics. La precisión lo cambia todo." />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader overlay={overlay} />
    <main id="contenido" class:list={[{ padded: !overlay && !flush }]} tabindex="-1"><slot /></main>
    <SiteFooter />
  </body>
</html>

<style>
  .padded { padding-top: var(--header-h); }
  main:focus { outline: none; }
</style>
