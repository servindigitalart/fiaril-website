---
import Base from '../../layouts/Base.astro';
import { experiments } from '../../lab/experiments';
---
<Base title="Creative Lab — FIARIL Kinetic Raster System">
  <section class="wrap intro">
    <p class="label">Fase 2 · Creative Lab</p>
    <h1>Kinetic Raster System</h1>
    <p>Experimentos aislados para evaluar antes de integrarse en la homepage. Cada uno respeta <code>prefers-reduced-motion</code> (imagen estática), pausa su loop fuera de pantalla y ofrece interacción táctil.</p>
  </section>
  <ol class="wrap grid">
    {experiments.map((e) => (
      <li>
        <a href={`/lab/${e.slug}/`}>
          <span class="label">{e.code} · {e.family}</span>
          <h2>{e.title}</h2>
          <p>{e.note}</p>
        </a>
      </li>
    ))}
  </ol>
</Base>

<style>
  .intro { padding-block: var(--space-l); }
  .grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); }
  .grid a { display: block; height: 100%; padding: var(--space-m); background: var(--color-surface); text-decoration: none; transition: background 0.3s var(--ease-out); }
  .grid a:hover { background: var(--color-surface-raised); }
  h2 { font-size: var(--step-2); margin-top: var(--space-l); }
  p { font-size: var(--step--1); color: var(--color-muted); }
</style>
