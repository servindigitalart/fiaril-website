---
// /cotizacion/ (D-050): the commercial conversion page. Navy-led, its own composition, red as the action
// accent. Reception stays OFF (D-031): no Netlify registration, no network, an honest "not sent" state.
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import instrumentRender from '../assets/renders/instrument.png';
import { RECEPCION_ACTIVA } from '../scripts/reception';
---
<Base flush title="Solicitar cotización · FIARIL Orthopedics" description="Solicite una cotización de implantes, equipamiento, consumibles quirúrgicos o acompañamiento técnico.">
  <section class="quote surface-navy" data-surface="navy" aria-labelledby="quote-title">
    <div class="halo" aria-hidden="true"></div>
    <div class="wrap quote-grid">
      <div class="intro">
        <nav class="crumbs t-meta" aria-label="Ruta"><a href="/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">Cotización</span></nav>
        <h1 id="quote-title" class="t-title">Hablemos de su próximo procedimiento.</h1>
        <p class="t-lead">Cuéntenos qué necesita y para qué institución. Con esa información, FIARIL prepara su cotización.</p>
        <figure class="figure intro-figure">
          <div class="intro-stage"><Picture src={instrumentRender} alt="" formats={['avif', 'webp']} widths={[360, 640]} sizes="(min-width: 64em) 30vw, 70vw" loading="eager" /></div>
          <figcaption class="t-meta">Visualización conceptual: instrumento quirúrgico.</figcaption>
        </figure>
        <div class="include">
          <p class="t-meta">Para una cotización precisa, incluya</p>
          <ul>
            <li>El producto o la línea de interés</li>
            <li>La institución de salud</li>
            <li>El procedimiento o la fecha prevista, si la conoce</li>
          </ul>
        </div>
      </div>

      <div class="panel">
        <form class="form" name="cotizacion" method="POST" novalidate
          data-netlify={RECEPCION_ACTIVA ? 'true' : undefined} netlify-honeypot={RECEPCION_ACTIVA ? 'sitio-web' : undefined}
          data-reception={RECEPCION_ACTIVA ? 'on' : 'off'}
          data-pending-title="Solicitud completa, sin enviar."
          data-pending-body="La recepción de solicitudes en línea se habilitará próximamente. Sus datos no se enviaron ni se almacenaron, y siguen en el formulario."
          data-ok-text="Solicitud enviada. FIARIL recibió su solicitud de cotización.">
          <input type="hidden" name="form-name" value="cotizacion" />
          <p class="trap" aria-hidden="true"><label>No llenar este campo <input name="sitio-web" tabindex="-1" autocomplete="off" /></label></p>
          <fieldset class="group wide">
            <legend class="t-meta">Su solicitud</legend>
            <div class="field"><label for="q-interes">Línea de interés</label>
              <select id="q-interes" name="interes" required aria-describedby="q-e-interes"><option value="" selected disabled>Seleccione una opción</option><option value="implantes">Implantes</option><option value="equipamiento">Equipamiento</option><option value="consumibles">Consumibles quirúrgicos</option><option value="acompanamiento">Acompañamiento técnico</option><option value="otra">Otra</option></select>
              <p class="error" id="q-e-interes" data-msg="Seleccione una línea de interés."></p></div>
            <div class="field"><label for="q-mensaje">Qué necesita</label><textarea id="q-mensaje" name="mensaje" rows="5" required aria-describedby="q-h-mensaje q-e-mensaje" placeholder="Producto, cantidad, procedimiento o fecha prevista…"></textarea><p class="help" id="q-h-mensaje">Cuanto más concreto sea, más precisa podrá ser la cotización.</p><p class="error" id="q-e-mensaje" data-msg="Describa qué necesita cotizar."></p></div>
          </fieldset>
          <fieldset class="group wide">
            <legend class="t-meta">Sus datos</legend>
            <div class="pair">
              <div class="field"><label for="q-nombre">Nombre y apellidos</label><input id="q-nombre" name="nombre" autocomplete="name" required aria-describedby="q-e-nombre" /><p class="error" id="q-e-nombre" data-msg="Indique su nombre."></p></div>
              <div class="field"><label for="q-institucion">Institución</label><input id="q-institucion" name="institucion" autocomplete="organization" required aria-describedby="q-e-institucion" /><p class="error" id="q-e-institucion" data-msg="Indique la institución de salud."></p></div>
              <div class="field"><label for="q-perfil">Perfil</label>
                <select id="q-perfil" name="perfil" required aria-describedby="q-e-perfil"><option value="" selected disabled>Seleccione una opción</option><option>Compras o abastecimiento</option><option>Cirujano o cirujana</option><option>Personal de quirófano</option><option>Otro</option></select>
                <p class="error" id="q-e-perfil" data-msg="Seleccione su perfil."></p></div>
              <div class="field"><label for="q-correo">Correo electrónico</label><input id="q-correo" name="correo" type="email" autocomplete="email" spellcheck="false" required placeholder="nombre@institucion.mx" aria-describedby="q-e-correo" /><p class="error" id="q-e-correo" data-msg="Indique un correo válido, por ejemplo nombre@institucion.mx."></p></div>
              <div class="field"><label for="q-telefono">Teléfono <span class="optional">(opcional)</span></label><input id="q-telefono" name="telefono" type="tel" autocomplete="tel" inputmode="tel" /></div>
            </div>
          </fieldset>
          <div class="field wide check"><input id="q-privacidad" name="privacidad" type="checkbox" value="aceptado" required aria-describedby="q-e-privacidad" /><label for="q-privacidad">He leído el <a href="/privacidad/">aviso de privacidad</a>.</label><p class="error" id="q-e-privacidad" data-msg="Confirme que ha leído el aviso de privacidad."></p></div>
          <div class="wide submit-row">
            <button class="btn submit" type="submit">Solicitar cotización</button>
            {!RECEPCION_ACTIVA && <p class="reception"><span class="reception-dot" aria-hidden="true"></span>Recepción en línea en preparación: este formulario todavía no envía datos.</p>}
          </div>
          <div class="wide status" role="status" aria-live="polite" tabindex="-1"></div>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  import { initForms } from '../scripts/forms';
  initForms();
</script>

<style>
  .quote { position: relative; overflow: clip; padding-block: calc(var(--header-h) + var(--space-l)) var(--space-xl); min-height: 100svh; }
  /* a dim halftone halo behind the intro: the operating-room light of the home, at rest */
  .halo {
    position: absolute; inset: 0 auto auto 0; width: min(70rem, 100%); height: 46rem; pointer-events: none;
    background: radial-gradient(circle, rgba(247, 247, 247, 0.5) 1.2px, transparent 1.8px) 0 0 / 14px 14px;
    -webkit-mask-image: radial-gradient(closest-side at 30% 40%, #000, transparent); mask-image: radial-gradient(closest-side at 30% 40%, #000, transparent);
    opacity: 0.35;
  }
  .quote-grid { position: relative; display: grid; gap: var(--space-l); }
  @media (min-width: 64em) { .quote-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--gutter); align-items: start; } }
  .intro { display: grid; gap: var(--space-m); align-content: start; }
  @media (min-width: 64em) { .intro { position: sticky; top: calc(var(--header-h) + var(--space-l)); } }
  .crumbs { display: flex; gap: 0.6em; }
  .crumbs a { color: var(--color-text-muted); }
  .crumbs [aria-current] { color: var(--color-text); }
  .intro .t-title { max-width: 13ch; }
  .intro-figure { max-width: 26rem; }
  .intro-stage { position: relative; aspect-ratio: 16 / 10; border-radius: var(--radius); background: radial-gradient(60% 70% at 50% 45%, color-mix(in srgb, var(--mineral) 12%, transparent), transparent 72%); }
  .intro-stage :global(img) { position: absolute; inset: 4% 8%; width: 84%; height: 92%; object-fit: contain; filter: drop-shadow(0 24px 30px rgb(0 0 0 / 0.45)); }
  .include ul { margin: var(--space-xs) 0 0; padding: 0; list-style: none; display: grid; gap: var(--space-2xs); }
  .include li { display: flex; gap: 0.75em; align-items: baseline; color: var(--color-text); }
  .include li::before { content: ''; flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent); transform: translateY(-2px); }

  /* the form is the protagonist: a raised panel with grouped fields */
  .panel { background: var(--color-surface-raised); border: var(--border-width) solid var(--color-border); border-radius: 6px; padding: clamp(1.25rem, 0.8rem + 2.4vw, 2.75rem); box-shadow: 0 40px 80px -50px rgb(0 0 0 / 0.6); }
  .panel .form { grid-template-columns: 1fr; }
  .group { border: 0; margin: 0; padding: 0; display: grid; gap: var(--space-m); }
  .group + .group { margin-top: var(--space-s); }
  .group legend { padding: 0; margin-bottom: var(--space-s); color: var(--color-accent); }
  .pair { display: grid; gap: var(--space-m) var(--space-s); }
  @media (min-width: 40em) { .pair { grid-template-columns: 1fr 1fr; } }
  .panel .field :is(input:not([type='checkbox']), select, textarea) { background-color: color-mix(in srgb, var(--orbital-navy) 70%, black); }
  /* the page's action accent: signal red (white on red 6.5:1) */
  .submit { --color-primary: var(--signal-red); --color-on-primary: var(--white); border-color: var(--signal-red); min-height: 52px; padding-inline: 1.8em; }
  @media (hover: hover) and (pointer: fine) {
    .submit:hover { background: color-mix(in srgb, var(--signal-red) 85%, black); color: var(--white); }
  }
</style>
