---
// Home, Creative Direction V2 (docs/14): light -> operating room -> light.
// Every statement comes from confirmed facts in PRODUCT.md. Images are labelled: renders are
// conceptual visualisations, radiographs are illustrative CC0 images (docs/06).
import Base from '../layouts/Base.astro';
import { Image, Picture } from 'astro:assets';
import hipRender from '../assets/renders/hip.png';
import instrumentRender from '../assets/renders/instrument.png';
import consumablesRender from '../assets/renders/consumables.png';
import kneeXray from '../assets/imaging/knee-lateral.jpg';
import hipXray from '../assets/imaging/hip-ap.jpg';

// Online reception stays OFF until FIARIL confirms who receives requests and publishes a valid
// privacy notice (LFPDPPP). While off, no form is registered with Netlify Forms, nothing is sent and
// CVs never leave the browser. To enable: set true, deploy, enable form detection (D-031, D-045).
const RECEPCION_ACTIVA = false;
const CV_MAX_MB = 5;

const lines = [
  { id: 'implantes', name: 'Implantes', img: hipRender, alt: 'Visualización conceptual de una prótesis de cadera en vista explosionada: vástago, cabeza cerámica y copa.', caption: 'Visualización conceptual: prótesis de cadera.' },
  { id: 'equipamiento', name: 'Equipamiento', img: instrumentRender, alt: 'Visualización conceptual de un instrumento quirúrgico con mango navy y punta hexagonal.', caption: 'Visualización conceptual: instrumento quirúrgico.' },
  { id: 'consumibles', name: 'Consumibles quirúrgicos', img: consumablesRender, alt: 'Visualización conceptual de agujas de Kirschner, una broca y tornillos.', caption: 'Visualización conceptual: agujas, broca y tornillos.' },
];
---
<Base title="FIARIL Orthopedics · La precisión lo cambia todo." overlay>
  <!-- ============ ACT I · LIGHT ============ -->
  <section class="hero" data-surface="mineral" aria-labelledby="hero-title">
    <canvas class="hero-field" aria-hidden="true"></canvas>
    <div class="wrap hero-grid">
      <div class="hero-stage" aria-hidden="true"></div>
      <div class="hero-copy">
        <h1 id="hero-title" class="t-display" data-clear>La precisión lo cambia todo.</h1>
        <p class="t-lead hero-lede" data-clear>Tecnología ortopédica y conocimiento especializado al servicio de cada procedimiento.</p>
        <div class="hero-actions" data-clear>
          <a class="btn" href="#contacto">Solicitar cotización</a>
          <a class="btn btn--ghost" href="#especialidades">Explorar especialidades</a>
        </div>
      </div>
      <div class="hero-foot">
        <p class="signature" data-clear translate="no">Ortopedia en movimiento.</p>
        <button class="field-toggle" type="button" data-clear hidden>Pausar animación</button>
      </div>
    </div>
  </section>

  <section id="nosotros" class="surface-mist section about" data-surface="mist" aria-labelledby="about-title">
    <div class="ruler" aria-hidden="true"></div>
    <div class="wrap about-grid">
      <div class="about-copy">
        <h2 id="about-title" class="t-title" data-reveal>Suministro especializado y presencia técnica en el procedimiento.</h2>
        <p class="t-lead" data-reveal style="--i: 1">FIARIL Orthopedics suministra implantes, equipamiento y consumibles quirúrgicos a instituciones de salud y acompaña técnicamente a los equipos durante los procedimientos quirúrgicos.</p>
        <dl class="spec">
          <div data-reveal style="--i: 2"><dt class="t-meta">Suministro</dt><dd>Implantes, equipamiento y consumibles quirúrgicos</dd></div>
          <div data-reveal style="--i: 3"><dt class="t-meta">Para</dt><dd>Instituciones de salud: áreas de compras y equipos quirúrgicos</dd></div>
          <div data-reveal style="--i: 4"><dt class="t-meta">En quirófano</dt><dd>Acompañamiento técnico durante el procedimiento</dd></div>
          <div data-reveal style="--i: 5"><dt class="t-meta">Cotización</dt><dd>Bajo solicitud, para cada institución</dd></div>
        </dl>
      </div>
      <figure class="figure xray xray-plate about-figure" data-reveal="mask">
        <div class="about-frame"><Image src={kneeXray} alt="Radiografía lateral de una rodilla con prótesis total." widths={[400, 640, 900]} sizes="(min-width: 64em) 36vw, 90vw" loading="lazy" /></div>
        <figcaption class="t-meta">Radiografía postoperatoria de una prótesis de rodilla. Imagen ilustrativa.</figcaption>
      </figure>
    </div>
  </section>
  <div class="band-into surface-mist" style="--band: var(--orbital-navy)" aria-hidden="true"></div>

  <!-- ============ ACT II · OPERATING ROOM ============ -->
  <section id="especialidades" class="surface-navy section lines" data-surface="navy" aria-labelledby="lines-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="lines-title" class="t-title" data-reveal>Especialidades</h2>
        <p class="t-lead" data-reveal style="--i: 1">Tres líneas de suministro para cirugía ortopédica.</p>
      </div>
      <ol class="lines-list">
        {lines.map((l) => (
          <li class="line">
            <figure class="figure line-figure" data-reveal="mask">
              <div class="line-stage">
                <div class="parallax"><Picture src={l.img} alt={l.alt} formats={['avif', 'webp']} widths={[420, 720, 1080]} sizes="(min-width: 64em) 46vw, 92vw" loading="lazy" /></div>
              </div>
              <figcaption class="t-meta">{l.caption}</figcaption>
            </figure>
            <div class="line-copy">
              <h3 class="t-subtitle" data-reveal>{l.name}</h3>
              <a class="btn btn--ghost" href="#contacto" data-interes={l.id} data-reveal style="--i: 1">Solicitar información</a>
            </div>
          </li>
        ))}
      </ol>
      <p class="t-lead lines-note" data-reveal>El catálogo por especialidad se publicará en esta sección. Mientras tanto, solicite información sobre el producto o el procedimiento que necesita.</p>
    </div>
  </section>
  <div class="fade-between" style="--from: var(--orbital-navy); --to: var(--graphite)" aria-hidden="true"></div>

  <section id="tecnologia" class="surface-graphite section tech" data-surface="graphite" aria-labelledby="tech-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="tech-title" class="t-title" data-reveal>Tecnología ortopédica</h2>
        <p class="t-lead" data-reveal style="--i: 1">Anatomía, materiales y geometría, en una visualización que se puede recorrer.</p>
      </div>
      <div class="tech-grid">
        <div class="viewer" data-reveal="mask">
          <div class="viewer-stage">
            <Picture class="viewer-fallback" src={hipRender} alt="" formats={['avif', 'webp']} widths={[420, 720]} sizes="(min-width: 64em) 40vw, 80vw" loading="lazy" />
            <canvas class="viewer-canvas" role="img" aria-label="Visualización 3D conceptual de una prótesis de cadera."></canvas>
          </div>
          <div class="viewer-controls">
            <div class="seg" role="group" aria-label="Modelo">
              <button type="button" aria-pressed="true" data-model="hip">Prótesis de cadera</button>
              <button type="button" aria-pressed="false" data-model="plate">Placa de fijación</button>
            </div>
            <div class="seg" role="group" aria-label="Vista">
              <button type="button" aria-pressed="true" data-view="material">Material</button>
              <button type="button" aria-pressed="false" data-view="geometry">Geometría</button>
            </div>
            <button class="viewer-pause" type="button" hidden>Pausar rotación</button>
          </div>
          <p class="t-meta">Visualización conceptual. No representa productos de FIARIL ni especificaciones reales.</p>
        </div>
        <figure class="figure xray tech-xray" data-reveal="mask">
          <div class="tech-frame"><Image src={hipXray} alt="Radiografía de cadera con artroplastia total." widths={[360, 560, 800]} sizes="(min-width: 64em) 26vw, 80vw" loading="lazy" /></div>
          <figcaption class="t-meta">Radiografía de cadera con artroplastia total. Imagen ilustrativa.</figcaption>
        </figure>
      </div>
    </div>
  </section>
  <div class="fade-between" style="--from: var(--graphite); --to: var(--orbital-navy)" aria-hidden="true"></div>

  <section id="acompanamiento" class="surface-navy section care" data-surface="navy" aria-labelledby="care-title">
    <div class="lamp" aria-hidden="true"></div>
    <div class="wrap care-grid">
      <h2 id="care-title" class="t-title" data-reveal>En el quirófano, junto al equipo quirúrgico.</h2>
      <div class="care-body">
        <p class="t-lead" data-reveal style="--i: 1">Además de suministrar el material, FIARIL acompaña técnicamente a los equipos durante el procedimiento quirúrgico.</p>
        <a class="btn" href="#contacto" data-interes="acompanamiento" data-reveal style="--i: 2">Consultar acompañamiento técnico</a>
      </div>
    </div>
  </section>
  <div class="band-out surface-mineral" style="--band: var(--orbital-navy)" aria-hidden="true"></div>

  <!-- ============ ACT III · BACK TO LIGHT ============ -->
  <section id="contacto" class="surface-mineral section contact" data-surface="mineral" aria-labelledby="contact-title">
    <div class="wrap form-grid">
      <div class="form-intro">
        <h2 id="contact-title" class="t-title" data-reveal>Solicitar cotización</h2>
        <p class="t-lead" data-reveal style="--i: 1">Describa el producto, la línea o el procedimiento, y la institución para la que solicita la cotización.</p>
      </div>
      <form class="form" name="cotizacion" method="POST" novalidate
        data-netlify={RECEPCION_ACTIVA ? 'true' : undefined} netlify-honeypot={RECEPCION_ACTIVA ? 'sitio-web' : undefined}
        data-reception={RECEPCION_ACTIVA ? 'on' : 'off'}
        data-pending-title="Solicitud completa, sin enviar."
        data-pending-body="La recepción de solicitudes en línea se habilitará próximamente. Sus datos no se enviaron ni se almacenaron, y siguen en el formulario."
        data-ok-text="Solicitud enviada. FIARIL recibió su solicitud de cotización.">
        <input type="hidden" name="form-name" value="cotizacion" />
        <p class="trap" aria-hidden="true"><label>No llenar este campo <input name="sitio-web" tabindex="-1" autocomplete="off" /></label></p>
        <div class="field"><label for="q-nombre">Nombre y apellidos</label><input id="q-nombre" name="nombre" autocomplete="name" required aria-describedby="q-e-nombre" /><p class="error" id="q-e-nombre" data-msg="Indique su nombre."></p></div>
        <div class="field"><label for="q-institucion">Institución</label><input id="q-institucion" name="institucion" autocomplete="organization" required aria-describedby="q-e-institucion" /><p class="error" id="q-e-institucion" data-msg="Indique la institución de salud."></p></div>
        <div class="field"><label for="q-perfil">Perfil</label>
          <select id="q-perfil" name="perfil" required aria-describedby="q-e-perfil"><option value="" selected disabled>Seleccione una opción</option><option>Compras o abastecimiento</option><option>Cirujano o cirujana</option><option>Personal de quirófano</option><option>Otro</option></select>
          <p class="error" id="q-e-perfil" data-msg="Seleccione su perfil."></p></div>
        <div class="field"><label for="q-interes">Línea de interés</label>
          <select id="q-interes" name="interes" required aria-describedby="q-e-interes"><option value="" selected disabled>Seleccione una opción</option><option value="implantes">Implantes</option><option value="equipamiento">Equipamiento</option><option value="consumibles">Consumibles quirúrgicos</option><option value="acompanamiento">Acompañamiento técnico</option><option value="otra">Otra</option></select>
          <p class="error" id="q-e-interes" data-msg="Seleccione una línea de interés."></p></div>
        <div class="field"><label for="q-correo">Correo electrónico</label><input id="q-correo" name="correo" type="email" autocomplete="email" spellcheck="false" required placeholder="nombre@institucion.mx" aria-describedby="q-e-correo" /><p class="error" id="q-e-correo" data-msg="Indique un correo válido, por ejemplo nombre@institucion.mx."></p></div>
        <div class="field"><label for="q-telefono">Teléfono <span class="optional">(opcional)</span></label><input id="q-telefono" name="telefono" type="tel" autocomplete="tel" inputmode="tel" /></div>
        <div class="field wide"><label for="q-mensaje">Mensaje</label><textarea id="q-mensaje" name="mensaje" rows="5" required aria-describedby="q-h-mensaje q-e-mensaje" placeholder="Producto, cantidad, procedimiento o fecha prevista…"></textarea><p class="help" id="q-h-mensaje">Cuanto más concreto sea, más precisa podrá ser la cotización.</p><p class="error" id="q-e-mensaje" data-msg="Describa qué necesita cotizar."></p></div>
        <div class="field wide check"><input id="q-privacidad" name="privacidad" type="checkbox" value="aceptado" required aria-describedby="q-e-privacidad" /><label for="q-privacidad">He leído el <a href="/privacidad/">aviso de privacidad</a>.</label><p class="error" id="q-e-privacidad" data-msg="Confirme que ha leído el aviso de privacidad."></p></div>
        <div class="wide submit-row">
          <button class="btn" type="submit">Solicitar cotización</button>
          {!RECEPCION_ACTIVA && <p class="reception"><span class="reception-dot" aria-hidden="true"></span>Recepción en línea en preparación: este formulario todavía no envía datos.</p>}
        </div>
        <div class="wide status" role="status" aria-live="polite" tabindex="-1"></div>
      </form>
    </div>
  </section>
  <div class="ruler-wrap surface-mist" aria-hidden="true"><div class="ruler"></div></div>

  <section id="bolsa-de-trabajo" class="surface-mist section careers" data-surface="mist" aria-labelledby="careers-title">
    <div class="wrap form-grid">
      <div class="form-intro">
        <h2 id="careers-title" class="t-title" data-reveal>Bolsa de trabajo</h2>
        <p class="t-lead" data-reveal style="--i: 1">Buscamos personas que quieran trabajar donde la precisión, el conocimiento técnico y la tecnología importan.</p>
        <p class="openings" data-reveal style="--i: 2"><span class="openings-dot" aria-hidden="true"></span>No hay vacantes publicadas en este momento. Las oportunidades se anunciarán en esta sección; mientras tanto, puede preparar su candidatura.</p>
      </div>
      <form class="form" name="candidatura" method="POST" enctype="multipart/form-data" novalidate
        data-netlify={RECEPCION_ACTIVA ? 'true' : undefined} netlify-honeypot={RECEPCION_ACTIVA ? 'sitio-web' : undefined}
        data-reception={RECEPCION_ACTIVA ? 'on' : 'off'}
        data-pending-title="Candidatura completa, sin enviar."
        data-pending-body="La recepción de candidaturas se habilitará próximamente. Sus datos y su CV no se enviaron ni se almacenaron: el archivo nunca salió de este dispositivo."
        data-ok-text="Candidatura enviada. FIARIL recibió su candidatura.">
        <input type="hidden" name="form-name" value="candidatura" />
        <p class="trap" aria-hidden="true"><label>No llenar este campo <input name="sitio-web" tabindex="-1" autocomplete="off" /></label></p>
        <div class="field"><label for="c-nombre">Nombre completo</label><input id="c-nombre" name="nombre" autocomplete="name" required aria-describedby="c-e-nombre" /><p class="error" id="c-e-nombre" data-msg="Indique su nombre completo."></p></div>
        <div class="field"><label for="c-correo">Correo electrónico</label><input id="c-correo" name="correo" type="email" autocomplete="email" spellcheck="false" required placeholder="nombre@correo.com" aria-describedby="c-e-correo" /><p class="error" id="c-e-correo" data-msg="Indique un correo válido, por ejemplo nombre@correo.com."></p></div>
        <div class="field"><label for="c-telefono">Teléfono <span class="optional">(opcional)</span></label><input id="c-telefono" name="telefono" type="tel" autocomplete="tel" inputmode="tel" /></div>
        <div class="field"><label for="c-area">Área de interés</label><input id="c-area" name="area" required aria-describedby="c-e-area" /><p class="error" id="c-e-area" data-msg="Indique en qué área le gustaría colaborar."></p></div>
        <div class="field wide"><label for="c-mensaje">Mensaje breve</label><textarea id="c-mensaje" name="mensaje" rows="4" maxlength="600" required aria-describedby="c-h-mensaje c-e-mensaje"></textarea><p class="help" id="c-h-mensaje">Hasta 600 caracteres: su experiencia y qué le interesa de FIARIL.</p><p class="error" id="c-e-mensaje" data-msg="Escriba un mensaje breve."></p></div>
        <div class="field wide">
          <span class="field-label" id="c-l-cv">CV en PDF</span>
          <div class="file">
            <input id="c-cv" name="cv" type="file" accept="application/pdf,.pdf" required data-max-bytes={CV_MAX_MB * 1048576} aria-labelledby="c-l-cv" aria-describedby="c-h-cv c-e-cv" />
            <div class="file-zone" aria-hidden="true"><span class="file-button">Seleccionar PDF</span><span class="file-name">Ningún archivo seleccionado</span></div>
          </div>
          <p class="help" id="c-h-cv">Formato PDF, máximo {CV_MAX_MB} MB.</p>
          <p class="error" id="c-e-cv" data-msg="Adjunte su CV en PDF." data-msg-type="El archivo debe ser un PDF." data-msg-size={`El archivo supera ${CV_MAX_MB} MB. Adjunte una versión más ligera.`}></p>
        </div>
        <div class="field wide check"><input id="c-privacidad" name="privacidad" type="checkbox" value="aceptado" required aria-describedby="c-e-privacidad" /><label for="c-privacidad">He leído el <a href="/privacidad/">aviso de privacidad</a>.</label><p class="error" id="c-e-privacidad" data-msg="Confirme que ha leído el aviso de privacidad."></p></div>
        <div class="wide submit-row">
          <button class="btn" type="submit">Enviar candidatura</button>
          {!RECEPCION_ACTIVA && <p class="reception"><span class="reception-dot" aria-hidden="true"></span>Recepción de candidaturas en preparación: su CV no saldrá de este dispositivo.</p>}
        </div>
        <div class="wide status" role="status" aria-live="polite" tabindex="-1"></div>
      </form>
    </div>
  </section>
</Base>

<script>
  import field from '../lab/f05-precision-field';
  import type { Rect } from '../lab/f05-precision-field';
  import { initForms } from '../scripts/forms';

  // ---------- Hero field (F05) ----------
  const hero = document.querySelector<HTMLElement>('.hero')!;
  const canvas = hero.querySelector<HTMLCanvasElement>('.hero-field')!;
  const stageEl = hero.querySelector<HTMLElement>('.hero-stage')!;
  const rect = (el: Element, pad = 0): Rect => {
    const c = canvas.getBoundingClientRect(), b = el.getBoundingClientRect();
    return [b.left - c.left - pad, b.top - c.top - pad, b.right - c.left + pad, b.bottom - c.top + pad];
  };
  const control = field(canvas, {
    focus: () => {
      const [l, t, r, b] = rect(stageEl), w = r - l, h = b - t;
      return { cx: l + w / 2, cy: t + h / 2, size: Math.max(60, Math.min(w / 3.3, h / 3.2)) };
    },
    holes: () => [...document.querySelectorAll('.hero [data-clear]:not([hidden]), .site-header .shell :is(.brand, .nav, .cta, .menu-btn)')].map((el) => rect(el, 10)),
  });
  document.fonts.ready.then(() => control.refresh());
  hero.querySelector('.hero-foot')!.addEventListener('animationend', () => control.refresh(), { once: true });
  new MutationObserver(() => control.refresh()).observe(document.querySelector('.site-header')!, { attributes: true, attributeFilter: ['data-state'] });
  const toggle = hero.querySelector<HTMLButtonElement>('.field-toggle')!;
  if (control.animated) {
    let paused = false;
    toggle.hidden = false;
    toggle.addEventListener('click', () => { paused = !paused; control.setPaused(paused); toggle.textContent = paused ? 'Reanudar animación' : 'Pausar animación'; });
  }

  // ---------- Reveals (text: fade; images: mask) ----------
  const reveal = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); reveal.unobserve(e.target); }
  }, { rootMargin: '0px 0px -10% 0px' });
  document.querySelectorAll('[data-reveal]').forEach((el) => reveal.observe(el));

  // ---------- 3D viewer: three.js is fetched only when the section approaches ----------
  const viewerEl = document.querySelector<HTMLElement>('.viewer')!;
  const lazy3d = new IntersectionObserver(async ([e]) => {
    if (!e.isIntersecting) return;
    lazy3d.disconnect();
    const { mountViewer } = await import('../three/viewer');
    const vcanvas = viewerEl.querySelector<HTMLCanvasElement>('.viewer-canvas')!;
    const viewer = mountViewer(vcanvas, 'hip');
    if (!viewer) return; // no WebGL: the static render stays
    const names = { hip: 'una prótesis de cadera', plate: 'una placa de fijación con tornillos' } as const;
    const press = (group: string, btn: HTMLButtonElement) => viewerEl.querySelectorAll<HTMLButtonElement>(`[${group}]`).forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    viewerEl.querySelectorAll<HTMLButtonElement>('[data-model]').forEach((b) => b.addEventListener('click', () => {
      const m = b.dataset.model as keyof typeof names;
      press('data-model', b); viewer.show(m);
      vcanvas.setAttribute('aria-label', `Visualización 3D conceptual de ${names[m]}.`);
    }));
    viewerEl.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', () => { press('data-view', b); viewer.setWire(b.dataset.view === 'geometry'); }));
    const pause = viewerEl.querySelector<HTMLButtonElement>('.viewer-pause')!;
    if (viewer.animated) {
      let p = false; pause.hidden = false;
      pause.addEventListener('click', () => { p = !p; viewer.setPaused(p); pause.textContent = p ? 'Reanudar rotación' : 'Pausar rotación'; });
    }
  }, { rootMargin: '600px 0px' });
  lazy3d.observe(viewerEl);

  // ---------- Surgical lamp (fine pointers only) ----------
  const care = document.querySelector<HTMLElement>('.care')!;
  const lamp = care.querySelector<HTMLElement>('.lamp')!;
  let lampFrame = 0;
  care.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse' || lampFrame) return;
    lampFrame = requestAnimationFrame(() => {
      lampFrame = 0;
      const b = lamp.getBoundingClientRect();
      lamp.style.setProperty('--lx', `${Math.min(100, Math.max(0, ((e.clientX - b.left) / b.width) * 100))}%`);
      lamp.style.setProperty('--ly', `${Math.min(100, Math.max(0, ((e.clientY - b.top) / b.height) * 100))}%`);
    });
  });
  care.addEventListener('pointerleave', () => { lamp.style.removeProperty('--lx'); lamp.style.removeProperty('--ly'); });

  // ---------- Forms ----------
  initForms();
  const interes = document.querySelector<HTMLSelectElement>('#q-interes')!;
  document.querySelectorAll<HTMLAnchorElement>('a[data-interes]').forEach((a) => a.addEventListener('click', () => { interes.value = a.dataset.interes!; }));
</script>

<style>
  /* ============ Hero ============ */
  .hero { position: relative; display: grid; min-height: 100svh; }
  .hero-field { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: pan-y; -webkit-mask-image: linear-gradient(#000 82%, transparent); mask-image: linear-gradient(#000 82%, transparent); }
  .hero-grid {
    position: relative; display: grid; grid-template-rows: minmax(min(46svh, 26rem), 1fr) auto auto; gap: var(--space-m);
    padding-block: var(--header-h) var(--space-m); pointer-events: none;
  }
  .hero-grid :is(a, button) { pointer-events: auto; }
  .hero-copy { align-self: end; }
  .hero-copy .t-display { max-width: 11ch; margin: 0; }
  .hero-lede { margin-top: var(--space-m); max-width: 34ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-top: var(--space-l); width: fit-content; }
  .hero-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-s); }
