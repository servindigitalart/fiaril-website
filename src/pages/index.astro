---
// Home, Creative Direction V2 (docs/14): light -> operating room -> light.
// Every statement comes from confirmed facts in PRODUCT.md. Images are labelled: renders are
// conceptual visualisations, radiographs are illustrative CC0 images (docs/06).
import Base from '../layouts/Base.astro';
import { Image, Picture } from 'astro:assets';
import hipRender from '../assets/renders/hip.png';
import instrumentRender from '../assets/renders/instrument.png';
import consumablesRender from '../assets/renders/consumables.png';
import kneeXray from '../assets/imaging/knee-lateral.jpg';
import hipXray from '../assets/imaging/hip-ap.jpg';

const lines = [
  { id: 'implantes', name: 'Implantes', img: hipRender, alt: 'Visualización conceptual de una prótesis de cadera en vista explosionada: vástago, cabeza cerámica y copa.', caption: 'Visualización conceptual: prótesis de cadera.' },
  { id: 'equipamiento', name: 'Equipamiento', img: instrumentRender, alt: 'Visualización conceptual de un instrumento quirúrgico con mango navy y punta hexagonal.', caption: 'Visualización conceptual: instrumento quirúrgico.' },
  { id: 'consumibles', name: 'Consumibles quirúrgicos', img: consumablesRender, alt: 'Visualización conceptual de agujas de Kirschner, una broca y tornillos.', caption: 'Visualización conceptual: agujas, broca y tornillos.' },
];
---
<Base title="FIARIL Orthopedics · La precisión lo cambia todo." overlay>
  <!-- ============ ACT I · LIGHT ============ -->
  <section class="hero" data-surface="mineral" aria-labelledby="hero-title">
    <canvas class="hero-field" aria-hidden="true"></canvas>
    <div class="wrap hero-grid">
      <div class="hero-stage" aria-hidden="true"></div>
      <div class="hero-copy">
        <h1 id="hero-title" class="t-display" data-clear>La precisión lo cambia todo.</h1>
        <p class="t-lead hero-lede" data-clear>Tecnología ortopédica y conocimiento especializado al servicio de cada procedimiento.</p>
        <div class="hero-actions" data-clear>
          <a class="btn" href="/cotizacion/">Solicitar cotización</a>
          <a class="btn btn--ghost" href="#especialidades">Explorar especialidades</a>
        </div>
      </div>
      <div class="hero-foot">
        <p class="signature" data-clear translate="no">Ortopedia en movimiento.</p>
        <button class="field-toggle" type="button" data-clear hidden>Pausar animación</button>
      </div>
    </div>
  </section>

  <section id="nosotros" class="surface-mist section about" data-surface="mist" aria-labelledby="about-title">
    <div class="ruler" aria-hidden="true"></div>
    <div class="wrap about-grid">
      <div class="about-copy">
        <h2 id="about-title" class="t-title" data-reveal>Suministro especializado y presencia técnica en el procedimiento.</h2>
        <p class="t-lead" data-reveal style="--i: 1">FIARIL Orthopedics suministra implantes, equipamiento y consumibles quirúrgicos a instituciones de salud y acompaña técnicamente a los equipos durante los procedimientos quirúrgicos.</p>
        <dl class="spec">
          <div data-reveal style="--i: 2"><dt class="t-meta">Suministro</dt><dd>Implantes, equipamiento y consumibles quirúrgicos</dd></div>
          <div data-reveal style="--i: 3"><dt class="t-meta">Para</dt><dd>Instituciones de salud: áreas de compras y equipos quirúrgicos</dd></div>
          <div data-reveal style="--i: 4"><dt class="t-meta">En quirófano</dt><dd>Acompañamiento técnico durante el procedimiento</dd></div>
          <div data-reveal style="--i: 5"><dt class="t-meta">Cotización</dt><dd>Bajo solicitud, para cada institución</dd></div>
        </dl>
      </div>
      <figure class="figure xray xray-plate about-figure" data-reveal="mask">
        <div class="about-frame"><Image src={kneeXray} alt="Radiografía lateral de una rodilla con prótesis total." widths={[400, 640, 900]} sizes="(min-width: 64em) 36vw, 90vw" loading="lazy" /></div>
        <figcaption class="t-meta">Radiografía postoperatoria de una prótesis de rodilla. Imagen ilustrativa.</figcaption>
      </figure>
    </div>
  </section>
  <div class="band-into surface-mist" style="--band: var(--orbital-navy)" aria-hidden="true"></div>

  <!-- ============ ACT II · OPERATING ROOM ============ -->
  <section id="especialidades" class="surface-navy section lines" data-surface="navy" aria-labelledby="lines-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="lines-title" class="t-title" data-reveal>Especialidades</h2>
        <p class="t-lead" data-reveal style="--i: 1">Tres líneas de suministro para cirugía ortopédica.</p>
      </div>
      <ol class="lines-list">
        {lines.map((l) => (
          <li class="line">
            <figure class="figure line-figure" data-reveal="mask">
              <div class="line-stage">
                <div class="parallax"><Picture src={l.img} alt={l.alt} formats={['avif', 'webp']} widths={[420, 720, 1080]} sizes="(min-width: 64em) 46vw, 92vw" loading="lazy" /></div>
              </div>
              <figcaption class="t-meta">{l.caption}</figcaption>
            </figure>
            <div class="line-copy">
              <h3 class="t-subtitle" data-reveal>{l.name}</h3>
              <a class="btn btn--ghost" href={`/cotizacion/?interes=${l.id}`} data-reveal style="--i: 1">Solicitar información</a>
            </div>
          </li>
        ))}
      </ol>
      <p class="t-lead lines-note" data-reveal>El catálogo por especialidad se publicará en esta sección. Mientras tanto, solicite información sobre el producto o el procedimiento que necesita.</p>
    </div>
  </section>
  <div class="fade-between" style="--from: var(--orbital-navy); --to: var(--graphite)" aria-hidden="true"></div>

  <section id="tecnologia" class="surface-graphite section tech" data-surface="graphite" aria-labelledby="tech-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="tech-title" class="t-title" data-reveal>Tecnología ortopédica</h2>
        <p class="t-lead" data-reveal style="--i: 1">Anatomía, materiales y geometría, en una visualización que se puede recorrer.</p>
      </div>
      <div class="tech-grid">
        <div class="viewer" data-reveal="mask">
          <div class="viewer-stage">
            <Picture class="viewer-fallback" src={hipRender} alt="" formats={['avif', 'webp']} widths={[420, 720]} sizes="(min-width: 64em) 40vw, 80vw" loading="lazy" />
            <canvas class="viewer-canvas" role="img" aria-label="Visualización 3D conceptual de una prótesis de cadera."></canvas>
            <button class="motion-toggle" type="button" data-label-pause="Pausar el movimiento de la visualización 3D" data-label-play="Reanudar el movimiento de la visualización 3D" aria-label="Pausar el movimiento de la visualización 3D" hidden><svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="4" y="3" width="2.6" height="10" rx="0.8"/><rect x="9.4" y="3" width="2.6" height="10" rx="0.8"/></svg><svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.2 3.1v9.8c0 .5.5.8.9.5l7.5-4.9a.6.6 0 0 0 0-1L6.1 2.6c-.4-.3-.9 0-.9.5z"/></svg></button>
          </div>
          <div class="viewer-controls">
            <div class="seg" role="group" aria-label="Modelo">
              <button type="button" aria-pressed="true" data-model="hip">Prótesis de cadera</button>
              <button type="button" aria-pressed="false" data-model="plate">Placa de fijación</button>
            </div>
            <div class="seg" role="group" aria-label="Vista">
              <button type="button" aria-pressed="true" data-view="material">Material</button>
              <button type="button" aria-pressed="false" data-view="geometry">Geometría</button>
            </div>
          </div>
          <p class="t-meta">Visualización conceptual. No representa productos de FIARIL ni especificaciones reales.</p>
        </div>
        <figure class="figure xray tech-xray" data-reveal="mask">
          <div class="tech-frame"><Image src={hipXray} alt="Radiografía de cadera con artroplastia total." widths={[360, 560, 800]} sizes="(min-width: 64em) 26vw, 80vw" loading="lazy" /></div>
          <figcaption class="t-meta">Radiografía de cadera con artroplastia total. Imagen ilustrativa.</figcaption>
        </figure>
      </div>
    </div>
  </section>
  <div class="fade-between" style="--from: var(--graphite); --to: var(--orbital-navy)" aria-hidden="true"></div>

  <section id="acompanamiento" class="surface-navy section care" data-surface="navy" aria-labelledby="care-title">
    <canvas class="care-field" aria-hidden="true"></canvas>
    <button class="motion-toggle care-toggle" type="button" data-label-pause="Pausar la animación del fondo" data-label-play="Reanudar la animación del fondo" aria-label="Pausar la animación del fondo" hidden><svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="4" y="3" width="2.6" height="10" rx="0.8"/><rect x="9.4" y="3" width="2.6" height="10" rx="0.8"/></svg><svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.2 3.1v9.8c0 .5.5.8.9.5l7.5-4.9a.6.6 0 0 0 0-1L6.1 2.6c-.4-.3-.9 0-.9.5z"/></svg></button>
    <div class="wrap care-grid">
      <h2 id="care-title" class="t-title" data-reveal>En el quirófano, junto al equipo quirúrgico.</h2>
      <div class="care-body">
        <p class="t-lead" data-reveal style="--i: 1">Además de suministrar el material, FIARIL acompaña técnicamente a los equipos durante el procedimiento quirúrgico.</p>
        <a class="btn" href="/cotizacion/?interes=acompanamiento" data-reveal style="--i: 2">Consultar acompañamiento técnico</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import field from '../lab/f05-precision-field';
  import type { Rect } from '../lab/f05-precision-field';
  import surgicalField from '../scripts/surgical-field';

  // ---------- Hero field (F05) ----------
  const hero = document.querySelector<HTMLElement>('.hero')!;
  const canvas = hero.querySelector<HTMLCanvasElement>('.hero-field')!;
  const stageEl = hero.querySelector<HTMLElement>('.hero-stage')!;
  const rect = (el: Element, pad = 0): Rect => {
    const c = canvas.getBoundingClientRect(), b = el.getBoundingClientRect();
    return [b.left - c.left - pad, b.top - c.top - pad, b.right - c.left + pad, b.bottom - c.top + pad];
  };
  const control = field(canvas, {
    focus: () => {
      const [l, t, r, b] = rect(stageEl), w = r - l, h = b - t;
      return { cx: l + w / 2, cy: t + h / 2, size: Math.max(60, Math.min(w / 3.3, h / 3.2)) };
    },
    holes: () => [...document.querySelectorAll('.hero [data-clear]:not([hidden]), .site-header .bar :is(.brand, .brand-full, .nav, .cta, .menu-btn)')].map((el) => rect(el, 10)),
  });
  document.fonts.ready.then(() => control.refresh());
  hero.querySelector('.hero-foot')!.addEventListener('animationend', () => control.refresh(), { once: true });
  new MutationObserver(() => control.refresh()).observe(document.querySelector('.site-header')!, { attributes: true, attributeFilter: ['data-state'] });
  const toggle = hero.querySelector<HTMLButtonElement>('.field-toggle')!;
  if (control.animated) {
    let paused = false;
    toggle.hidden = false;
    toggle.addEventListener('click', () => { paused = !paused; control.setPaused(paused); toggle.textContent = paused ? 'Reanudar animación' : 'Pausar animación'; });
  }

  // ---------- Discreet pause controls (D-055): icon state + accessible label; hidden when nothing moves ----------
  function motionToggle(btn: HTMLButtonElement, control: { animated: boolean; setPaused(p: boolean): void }) {
    if (!control.animated) return;
    let paused = false;
    btn.hidden = false;
    btn.addEventListener('click', () => {
      paused = !paused;
      control.setPaused(paused);
      btn.toggleAttribute('data-paused', paused);
      btn.setAttribute('aria-label', btn.dataset[paused ? 'labelPlay' : 'labelPause']!);
    });
  }

  // ---------- Reveals (text: fade; images: mask) ----------
  const reveal = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); reveal.unobserve(e.target); }
  }, { rootMargin: '0px 0px -10% 0px' });
  document.querySelectorAll('[data-reveal]').forEach((el) => reveal.observe(el));

  // ---------- 3D viewer: three.js is fetched only when the section approaches ----------
  const viewerEl = document.querySelector<HTMLElement>('.viewer')!;
  const lazy3d = new IntersectionObserver(async ([e]) => {
    if (!e.isIntersecting) return;
    lazy3d.disconnect();
    const { mountViewer } = await import('../three/viewer');
    const vcanvas = viewerEl.querySelector<HTMLCanvasElement>('.viewer-canvas')!;
    const viewer = mountViewer(vcanvas, 'hip');
    if (!viewer) return; // no WebGL: the static render stays
    motionToggle(viewerEl.querySelector<HTMLButtonElement>('.motion-toggle')!, viewer);
    const names = { hip: 'una prótesis de cadera', plate: 'una placa de fijación con tornillos' } as const;
    const press = (group: string, btn: HTMLButtonElement) => viewerEl.querySelectorAll<HTMLButtonElement>(`[${group}]`).forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    viewerEl.querySelectorAll<HTMLButtonElement>('[data-model]').forEach((b) => b.addEventListener('click', () => {
      const m = b.dataset.model as keyof typeof names;
      press('data-model', b); viewer.show(m);
      vcanvas.setAttribute('aria-label', `Visualización 3D conceptual de ${names[m]}.`);
    }));
    viewerEl.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', () => { press('data-view', b); viewer.setWire(b.dataset.view === 'geometry'); }));
  }, { rootMargin: '600px 0px' });
  lazy3d.observe(viewerEl);

  // ---------- Surgical lamp field (Acompañamiento) ----------
  const care = document.querySelector<HTMLElement>('.care')!;
  const careCanvas = care.querySelector<HTMLCanvasElement>('.care-field')!;
  const lamp = surgicalField(careCanvas, () => [...care.querySelectorAll('.care-grid :is(h2, p, .btn)')].map((el) => {
    const c = careCanvas.getBoundingClientRect(), r = el.getBoundingClientRect();
    return [r.left - c.left, r.top - c.top, r.right - c.left, r.bottom - c.top] as [number, number, number, number];
  }));
  document.fonts.ready.then(() => lamp.refresh());
  motionToggle(care.querySelector<HTMLButtonElement>('.care-toggle')!, lamp);
</script>

<style>
  /* ============ Hero ============ */
  .hero { position: relative; display: grid; min-height: 100svh; }
  .hero-field { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: pan-y; -webkit-mask-image: linear-gradient(#000 82%, transparent); mask-image: linear-gradient(#000 82%, transparent); }
  .hero-grid {
    position: relative; display: grid; grid-template-rows: minmax(min(46svh, 26rem), 1fr) auto auto; gap: var(--space-m);
    padding-block: var(--header-h) var(--space-m); pointer-events: none;
  }
  .hero-grid :is(a, button) { pointer-events: auto; }
  .hero-copy { align-self: end; }
  .hero-copy .t-display { max-width: 11ch; margin: 0; }
  .hero-lede { margin-top: var(--space-m); max-width: 34ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-top: var(--space-l); width: fit-content; }
  .hero-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-s); }
  .signature { margin: 0; font-size: var(--type-meta); font-weight: var(--weight-heading); letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); }
  .field-toggle, .seg button {
    min-height: 44px; padding: 0 1em; border: var(--border-width) solid var(--color-border-control); border-radius: var(--radius-pill);
    background: transparent; color: var(--color-text); font: var(--weight-ui) var(--type-meta) / 1 var(--font-sans);
    cursor: pointer; touch-action: manipulation;
    transition: background-color var(--dur-hover) var(--ease-out), color var(--dur-hover) var(--ease-out), border-color var(--dur-hover) var(--ease-out), transform var(--dur-press) var(--ease-out);
  }
  .field-toggle { background: var(--color-surface); }
  :is(.field-toggle, .seg button):active { transform: scale(var(--press-scale)); }
  @media (hover: hover) and (pointer: fine) { .field-toggle:hover { border-color: var(--color-text); } }
  @media (min-width: 64em), (orientation: landscape) and (min-width: 40em) and (max-height: 34em) {
    .hero-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-rows: 1fr auto; column-gap: var(--gutter); }
    .hero-copy { grid-area: 1 / 1; align-self: center; }
    .hero-stage { grid-area: 1 / 2; }
    .hero-foot { grid-area: 2 / 1 / 3 / 3; }
  }
  @media (min-width: 64em) { .hero-grid { padding-top: calc(136px + var(--space-l)); } }
  @media (orientation: landscape) and (max-height: 34em) {
    .hero-grid { padding-top: calc(var(--header-h) + var(--space-s)); }
    .hero-copy .t-display { font-size: clamp(2rem, 1rem + 5vh, 3rem); }
    .hero-lede { margin-top: var(--space-s); font-size: var(--step-0); }
    .hero-actions { margin-top: var(--space-m); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > *, .hero-foot { animation: hero-in 900ms var(--ease-out) both; }
    .hero-lede { animation-delay: 120ms; } .hero-actions { animation-delay: 220ms; } .hero-foot { animation-delay: 600ms; }
    @keyframes hero-in { from { opacity: 0; transform: translateY(18px); } }
  }

  /* ============ Nosotros (mist) ============ */
  .about { padding-top: 0; }
  .about .ruler { margin-bottom: var(--space-xl); }
  .about-grid { display: grid; gap: var(--space-l); align-items: center; }
  .about-copy { display: grid; gap: var(--space-m); }
  @media (min-width: 64em) { .about-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--gutter); } }
  .about-frame { aspect-ratio: 3 / 4; max-height: 78svh; }
  .about-figure { width: min(100%, 30rem); justify-self: center; }
  .spec { margin: var(--space-s) 0 0; }
  .spec div { position: relative; display: grid; gap: var(--space-2xs); padding-block: var(--space-s); }
  @media (min-width: 40em) { .spec div { grid-template-columns: 10rem 1fr; gap: var(--space-m); align-items: baseline; } }
  .spec div::before { content: ''; position: absolute; inset: 0 0 auto; height: var(--border-width); background: var(--color-border-control); opacity: 0.45; transform-origin: left; }
  .spec div:last-child { box-shadow: inset 0 calc(-1 * var(--border-width)) 0 color-mix(in srgb, var(--color-border-control) 45%, transparent); }
  @media (prefers-reduced-motion: no-preference) {
    .js .spec div::before { transition: transform 900ms var(--ease-in-out); transition-delay: calc(var(--i, 0) * 70ms); }
    .js .spec div:not(.is-in)::before { transform: scaleX(0); }
  }
  .spec dd { margin: 0; }

  /* ============ Especialidades (navy) ============ */
  .lines-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-xl); }
  .line { display: grid; gap: var(--space-m); align-items: center; }
  @media (min-width: 48em) {
    .line { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--gutter); }
    /* mirrored rows keep the same proportions: the image always gets the wide track */
    .line:nth-child(even) { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .line:nth-child(even) .line-figure { order: 2; }
  }
  .line-stage {
    position: relative; aspect-ratio: 4 / 3; overflow: clip; border-radius: var(--radius);
    /* studio light: a soft pool on the surface, the render floats in it */
    background: radial-gradient(60% 70% at 50% 45%, color-mix(in srgb, var(--mineral) 11%, transparent), transparent 72%), var(--color-surface-raised);
  }
  /* explicit box + contain: the render's intrinsic size can never drive the layout */
  .line-stage .parallax { position: absolute; inset: 0; }
  .line-stage :global(img) { position: absolute; inset: 8% 10%; width: 80%; height: 84%; object-fit: contain; filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.45)); }
  .line-copy { display: grid; gap: var(--space-m); justify-items: start; }
  .lines-note { margin-top: var(--space-xl); }

  /* ============ Tecnología (graphite) ============ */
  .tech-grid { display: grid; gap: var(--space-l); }
  @media (min-width: 64em) { .tech-grid { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); column-gap: var(--gutter); align-items: end; } }
  .viewer { display: grid; gap: var(--space-s); }
  .viewer-stage {
    position: relative; aspect-ratio: 4 / 3; overflow: clip; border-radius: var(--radius);
    background: radial-gradient(55% 65% at 50% 45%, color-mix(in srgb, var(--mineral) 10%, transparent), transparent 75%), var(--color-surface-raised);
  }
  .viewer-stage :global(img) { position: absolute; inset: 8%; width: 84%; height: 84%; object-fit: contain; transition: opacity var(--dur-reveal) var(--ease-out); }
  .viewer-canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: pan-y; opacity: 0; transition: opacity var(--dur-reveal) var(--ease-out); }
  .viewer:global(.is-live) .viewer-canvas { opacity: 1; }
  .viewer:global(.is-live) .viewer-stage :global(img) { opacity: 0; }
  .viewer-controls { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-s); align-items: center; }
  .seg { display: inline-flex; padding: 3px; gap: 2px; border: var(--border-width) solid var(--color-border); border-radius: var(--radius-pill); }
  .seg button { border-color: transparent; color: var(--color-text-muted); }
  .seg button[aria-pressed='true'] { background: var(--color-primary); color: var(--color-on-primary); }
  @media (hover: hover) and (pointer: fine) { .seg button[aria-pressed='false']:hover { color: var(--color-text); } }
  .tech-frame { aspect-ratio: 3 / 5; max-height: 70svh; }
  .tech-xray { width: min(100%, 24rem); justify-self: center; }

  /* ============ Discreet motion controls (D-055) ============ */
  .motion-toggle {
    position: absolute; right: var(--space-s); bottom: var(--space-s); z-index: 2;
    display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border-radius: 50%;
    border: var(--border-width) solid var(--color-border); color: var(--color-text);
    background: color-mix(in srgb, var(--color-surface) 70%, transparent);
    cursor: pointer; touch-action: manipulation; opacity: 0.72;
    transition: opacity var(--dur-hover) var(--ease-out), border-color var(--dur-hover) var(--ease-out), transform var(--dur-press) var(--ease-out), box-shadow var(--dur-ui) var(--ease-out);
  }
  .motion-toggle svg { width: 14px; height: 14px; fill: currentColor; }
  .motion-toggle .i-play, .motion-toggle[data-paused] .i-pause { display: none; }
  .motion-toggle[data-paused] .i-play { display: block; }
  /* paused is a state worth seeing: full opacity and an accent ring */
  .motion-toggle[data-paused] { opacity: 1; box-shadow: 0 0 0 2px var(--color-accent); }
  .motion-toggle:focus-visible { opacity: 1; }
  .motion-toggle:active { transform: scale(var(--press-scale)); }
  @media (hover: hover) and (pointer: fine) { .motion-toggle:hover { opacity: 1; border-color: var(--color-text-muted); } }
  .care-toggle { right: var(--gutter); bottom: var(--space-m); }

  /* ============ Acompañamiento (navy, surgical lamp) ============ */
