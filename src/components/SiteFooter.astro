---
// Footer V2.1 (D-052): a short institutional close. Graphite surface, one message, one CTA, minimal links.
// No invented contact data. Identity = approved isotype on a mineral disc (no negative logo, D-018).
import { Image } from 'astro:assets';
import isotype from '../assets/isotype.png';
const year = new Date().getFullYear();
const onQuote = Astro.url.pathname.startsWith('/cotizacion');
---
<footer class="site-footer surface-graphite" data-surface="graphite">
  <div class="wrap">
    <div class="close">
      <h2 class="t-title">La precisión empieza con una conversación.</h2>
      {!onQuote && <a class="btn close-cta" href="/cotizacion/">Solicitar cotización</a>}
    </div>
    <div class="ruler" aria-hidden="true"></div>
    <div class="meta">
      <a class="identity" href="/" aria-label="FIARIL Orthopedics, inicio" translate="no">
        <span class="chip"><Image src={isotype} alt="" height={30} densities={[1, 2]} /></span>
        <span class="signature">Ortopedia en movimiento.</span>
      </a>
      <nav aria-label="Pie de página">
        <ul>
          <li><a href="/#especialidades">Especialidades</a></li>
          <li><a href="/#tecnologia">Tecnología</a></li>
          <li><a href="/#acompanamiento">Acompañamiento</a></li>
          <li><a href="/bolsa-de-trabajo/">Bolsa de trabajo</a></li>
          <li><a href="/privacidad/">Aviso de privacidad</a></li>
          <li><a href="/lab/">Creative Lab</a></li>
        </ul>
      </nav>
      <p class="t-meta copy">© {year} FIARIL Orthopedics</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: var(--space-xl) var(--space-l); }
  .close { display: grid; gap: var(--space-l); align-items: end; padding-bottom: var(--space-xl); }
  .close .t-title { max-width: 16ch; }
  @media (min-width: 48em) { .close { grid-template-columns: 1fr auto; } }
  .close-cta { justify-self: start; --color-primary: var(--signal-red); --color-on-primary: var(--white); border-color: var(--signal-red); }
  @media (hover: hover) and (pointer: fine) { .close-cta:hover { background: transparent; color: var(--mineral); border-color: var(--mineral); } }
  .ruler { opacity: 0.35; margin-bottom: var(--space-l); }
  .meta { display: grid; gap: var(--space-m); align-items: center; }
  @media (min-width: 64em) { .meta { grid-template-columns: auto 1fr auto; column-gap: var(--space-l); } }
  .identity { display: inline-flex; align-items: center; gap: var(--space-s); text-decoration: none; border-radius: var(--radius-pill); }
  .chip { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--mineral); }
  .chip :global(img) { height: 30px; width: auto; }
  .signature { font-size: var(--type-meta); font-weight: var(--weight-heading); letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 var(--space-m); }
  @media (min-width: 64em) { nav ul { justify-content: center; } }
  nav a { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--type-meta); font-weight: var(--weight-ui); color: var(--color-text-muted); text-decoration: none; transition: color var(--dur-hover) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { nav a:hover { color: var(--color-text); } }
  .copy { white-space: nowrap; }
</style>
